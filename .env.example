# Reference template only. Do not put real credentials in this file. Inject secrets into the process environment or your hosting secret manager.
# Required: use a private PostgreSQL instance. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/atelier_noir?sslmode=require"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin bootstrap: used only by `npm run db:seed`; never expose these values.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"

# Distributed rate limiting (required in production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Razorpay server-side credentials. Optional until payments are enabled.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

